{
  "name": "react-native-offline-game",
  "version": "1.1.0",
  "description": "Chrome-style \"No internet\" screen with the dinosaur game for React Native. Appears when the device goes offline and closes when the connection comes back.",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "!**/*.map",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "clean": "del-cli lib",
    "prepare": "bob build",
    "typecheck": "tsc",
    "test": "jest",
    "sprites": "node scripts/generate-sprites.mjs"
  },
  "keywords": [
    "react-native",
    "offline",
    "no-internet",
    "netinfo",
    "dino",
    "dinosaur",
    "t-rex",
    "chrome",
    "game",
    "ios",
    "android",
    "sound",
    "pterodactyl",
    "web"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SagarKhengat/react-native-offline-game.git"
  },
  "author": "Sagar Khengat (https://github.com/SagarKhengat)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/SagarKhengat/react-native-offline-game/issues"
  },
  "homepage": "https://github.com/SagarKhengat/react-native-offline-game#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@react-native-community/netinfo": ">=9.0.0",
    "react": ">=18.0.0",
    "react-native": ">=0.71.0",
    "react-native-audio-api": "*",
    "@react-native-async-storage/async-storage": "*"
  },
  "peerDependenciesMeta": {
    "react-native-audio-api": {
      "optional": true
    },
    "@react-native-async-storage/async-storage": {
      "optional": true
    }
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native/babel-preset": "^0.88.1",
    "@react-native/jest-preset": "^0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.3.0",
    "del-cli": "^8.0.1",
    "jest": "^29.7.0",
    "pngjs": "^7.0.0",
    "react": "^19.3.0",
    "react-native": "^0.88.1",
    "react-native-builder-bob": "^0.44.1",
    "test-renderer": "^1.3.1",
    "typescript": "^6.0.3"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true,
          "sourceMaps": false
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "modulePathIgnorePatterns": [
      "<rootDir>/lib/"
    ]
  }
}
